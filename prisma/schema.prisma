// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model DischargeFacility {
 id String @id @default(cuid())
 name String
 permitNumber String
 operator String
 sewerAuthority String
 address String
 reportingYear Int
 openedAt DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseDischargePoint_dischargeFacilityId DischargePoint[] @relation("DischargePoint_dischargeFacilityId")
 inverseEffluentLimit_dischargeFacilityId EffluentLimit[] @relation("EffluentLimit_dischargeFacilityId")
 inverseEffluentSample_dischargeFacilityId EffluentSample[] @relation("EffluentSample_dischargeFacilityId")
 inverseFlowReading_dischargeFacilityId FlowReading[] @relation("FlowReading_dischargeFacilityId")
 inverseLabCustody_dischargeFacilityId LabCustody[] @relation("LabCustody_dischargeFacilityId")
 inversePretreatmentAsset_dischargeFacilityId PretreatmentAsset[] @relation("PretreatmentAsset_dischargeFacilityId")
 inverseDischargeIncident_dischargeFacilityId DischargeIncident[] @relation("DischargeIncident_dischargeFacilityId")
 inverseDischargeReport_dischargeFacilityId DischargeReport[] @relation("DischargeReport_dischargeFacilityId")
 inverseOperationalTask_dischargeFacilityId OperationalTask[] @relation("OperationalTask_dischargeFacilityId")
 inverseRuleVersion_dischargeFacilityId RuleVersion[] @relation("RuleVersion_dischargeFacilityId")
 inverseDocumentRequirement_dischargeFacilityId DocumentRequirement[] @relation("DocumentRequirement_dischargeFacilityId")
}

model DischargePoint {
 id String @id @default(cuid())
 name String
 pointCode String
 location String
 process String
 sampleFrequency String
 status String @default("Draft")
 dischargeFacilityId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([dischargeFacilityId])
 linkedDischargeFacilityId DischargeFacility @relation("DischargePoint_dischargeFacilityId", fields: [dischargeFacilityId], references: [id], onDelete: Restrict)
 inverseEffluentSample_dischargePointId EffluentSample[] @relation("EffluentSample_dischargePointId")
 inverseFlowReading_dischargePointId FlowReading[] @relation("FlowReading_dischargePointId")
 inverseLabCustody_dischargePointId LabCustody[] @relation("LabCustody_dischargePointId")
 inverseDischargeIncident_dischargePointId DischargeIncident[] @relation("DischargeIncident_dischargePointId")
}

model EffluentLimit {
 id String @id @default(cuid())
 title String
 parameter String
 limitValue Float
 unit String
 averagingPeriod String
 ruleVersion String
 status String @default("Draft")
 dischargeFacilityId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([dischargeFacilityId])
 linkedDischargeFacilityId DischargeFacility @relation("EffluentLimit_dischargeFacilityId", fields: [dischargeFacilityId], references: [id], onDelete: Restrict)
}

model EffluentSample {
 id String @id @default(cuid())
